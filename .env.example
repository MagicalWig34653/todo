# Copy to .env for local overrides. Values below are dev-only placeholders.
DB_ROOT_PASSWORD=dev-root-only
DB_NAME=todo
DB_USER=todo
DB_PASSWORD=dev-only
DB_HOST_PORT=23306
# Only used with `docker compose --profile s3`:
S3_HOST_PORT=29090
BACKEND_HOST_PORT=28080
RP_ID=localhost
RP_ORIGIN=http://localhost:25173
# Apple app IDs (TeamID.BundleID, comma separated) for /.well-known/apple-app-site-association; unset = 404.
# Production example (domain todo.linolaske.de): RP_ID=todo.linolaske.de, RP_ORIGIN=https://todo.linolaske.de
#AASA_APP_IDS=J2DU2P47XW.de.linolaske.todo,J2DU2P47XW.de.linolaske.todo.mac
PASSWORD_LOGIN_ENABLED=false
BOOTSTRAP_TOKEN=dev-bootstrap-only
# Attachments are stored in the database by default (no S3 needed). Optional S3 for tests of the S3 store:
#   docker compose --profile s3 up -d --wait db s3
#ATTACHMENT_STORAGE=s3
#S3_ENDPOINT=http://s3:9090           # backend container; from the host: http://127.0.0.1:29090
#ATTACHMENT_MAX_BYTES=10485760        # per-file limit, default 10 MiB
