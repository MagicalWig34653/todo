# Example environment for deploy/swarm/stack.yaml. Placeholders only - never commit real values.
# Usage (on a Swarm manager):
#   cp deploy/swarm/stack.env.example /secure/path/todo.env   # then edit
#   set -a; . /secure/path/todo.env; set +a
#   scripts/swarm-deploy.sh
# MariaDB is EXTERNAL and must be reachable from all Swarm nodes. Attachments live in the database by default;
# S3-compatible storage is optional (see the S3 section below).

# --- Image -------------------------------------------------------------------
# Published by .github/workflows/docker-publish.yml as ghcr.io/magicalwig34653/todo-backend.
# Tags: edge (main), sha-<commit>, <version>, <major>.<minor>. Prefer a pinned tag.
TODO_IMAGE_TAG=edge
# Replicas of the API service.
BACKEND_REPLICAS=3
# Published ingress port (put a TLS reverse proxy in front for production).
BACKEND_PORT=38080

# --- External MariaDB --------------------------------------------------------
DB_HOST=db.example.internal
DB_PORT=3306
DB_NAME=todo
DB_USER=todo
# Password is a Swarm secret, never an env value:
#   docker secret create todo_db_password /secure/path/db-password
# Use DB_PASSWORD_SECRET to choose a different secret name.
#DB_PASSWORD_SECRET=todo_db_password

# --- Settings in the PWA (ADR 0025, docs/KONFIGURATION.md) -------------------
# Resolution: environment variable (non-empty) > value saved in the PWA > default. A variable set here LOCKS the setting in
# the PWA (read-only, origin "Umgebung"). Leave a variable out - or empty - to let administrators change it in the PWA
# (Einstellungen > Verwaltung > Server). Everything below that has a default in the application is therefore commented out.
# Key for secrets saved in the PWA (SMTP password, APNs key, S3 keys; AES-256-GCM in the database). setup.sh creates it:
#   openssl rand -base64 32 | tr -d '\n' | docker secret create todo_settings_key -
# The key must NOT be in the same backup as the database. Rotation: docs/KONFIGURATION.md.
#SETTINGS_KEY_ENABLED=true
#SETTINGS_KEY_SECRET=todo_settings_key
#SETTINGS_KEY_PREVIOUS_SECRET=
# Name of this instance as reported to clients (default Todolino).
#INSTANCE_NAME=Todolino

# --- Attachment storage ------------------------------------------------------
# Default: attachments are stored in the database (table attachment_blobs). No S3 needed.
#ATTACHMENT_STORAGE=database
# Largest single attachment in bytes (default 10 MiB, hard maximum 134217728). The reverse proxy must allow it
# (nginx: client_max_body_size) and MariaDB max_allowed_packet must be at least 2 MiB (default 16 MiB is fine).
#ATTACHMENT_MAX_BYTES=10485760
# OPTIONAL S3: set ATTACHMENT_STORAGE=s3 and uncomment the block below. With S3_ENDPOINT set, scripts/swarm-deploy.sh adds
# deploy/swarm/stack.s3.yaml (S3 variables and secrets). Keys are Swarm secrets:
#   docker secret create todo_s3_access_key /secure/path/s3-access-key
#   docker secret create todo_s3_secret_key /secure/path/s3-secret-key
#S3_ENDPOINT=https://s3.example.internal
#S3_BUCKET=todo-attachments
#S3_REGION=us-east-1
#S3_ACCESS_KEY_SECRET=todo_s3_access_key
#S3_SECRET_KEY_SECRET=todo_s3_secret_key

# --- Application -------------------------------------------------------------
# WebAuthn relying party: RP_ID is the bare domain, RP_ORIGIN the exact browser origin.
RP_ID=todo.linolaske.de
RP_ORIGIN=https://todo.linolaske.de
# Public base URL for OAuth/MCP discovery (issuer, endpoints, resource indicator). Optional: empty means RP_ORIGIN.
OAUTH_ISSUER=https://todo.linolaske.de
# Periodic cleanup of expired sessions, challenges, tokens etc. inside the API replicas; only one replica works at a time
# (database lease). Minutes between runs, default 360 (6 h). 0 disables it (then schedule `cleanup-expired` yourself).
#CLEANUP_INTERVAL_MINUTES=360
# Sync change log: tombstones and stored mutation results older than this many days are purged; clients with an older
# cursor receive 410 cursor_expired and resync from scratch. Default 90. 0 keeps everything.
#SYNC_RETENTION_DAYS=90
# Apple app IDs (TeamID.BundleID, comma separated) served at /.well-known/apple-app-site-association (webcredentials).
# Unset: the endpoint answers 404.
AASA_APP_IDS=J2DU2P47XW.de.linolaske.todo,J2DU2P47XW.de.linolaske.todo.mac
# --- Push notifications (APNs, optional; docs/PUSH-EINRICHTUNG.md) -----------
# Off unless APNS_ENABLED=true. Then scripts/swarm-deploy.sh adds deploy/swarm/stack.push.yaml and the backend refuses
# to start when the key, key ID or team ID is missing or invalid. The .p8 key is a Swarm secret, never an env value:
#   docker secret create todo_apns_key ./AuthKey_XXXXXXXXXX.p8
#APNS_ENABLED=true
#APNS_KEY_ID=XXXXXXXXXX
#APNS_TEAM_ID=XXXXXXXXXX
# Bundle IDs (comma separated) that may receive pushes; the first one is the default.
#APNS_TOPIC=de.linolaske.todo
# Default for devices that name no environment: production (TestFlight, App Store) or sandbox (Xcode debug builds).
#APNS_ENVIRONMENT=production
#APNS_KEY_SECRET=todo_apns_key
# Bootstrap token is a Swarm secret:
#   docker secret create todo_bootstrap_token /secure/path/bootstrap-token
#BOOTSTRAP_TOKEN_SECRET=todo_bootstrap_token

# --- Outgoing e-mail (optional; docs/MAIL-EINRICHTUNG.md) ---------------------
# Off unless MAIL_ENABLED=true. Then scripts/swarm-deploy.sh adds deploy/swarm/stack.mail.yaml and the backend refuses to
# start with an incomplete configuration. The SMTP password is a Swarm secret, never a value in this file:
#   printf '%s' 'the-smtp-password' | docker secret create todo_smtp_password -
#MAIL_ENABLED=true
#SMTP_HOST=smtp.example.org
# starttls (port 587, default), tls (port 465) or none (only for a local relay without credentials; not usable in Swarm)
#SMTP_SECURITY=starttls
#SMTP_PORT=587
#SMTP_USER=todolino@example.org
#MAIL_FROM=todolino@example.org
#MAIL_FROM_NAME=Todolino
#SMTP_PASSWORD_SECRET=todo_smtp_password

# --- Placement (optional; docs/BETRIEB.md "Platzierung") ----------------------
# All empty = Swarm decides. scripts/swarm-deploy.sh sources deploy/swarm/placement.sh, validates the values and adds a
# generated overlay for backend and migrate. Comma separated lists, no quotes needed.
#PLACEMENT_CONSTRAINTS=node.role==worker,node.labels.zone!=dev
# Spread replicas evenly over the values of these labels.
#PLACEMENT_PREFERENCES=node.labels.zone
# Nodes labelled <EXCLUDE_LABEL>=true get no backend/migrate task (docker node update --label-add noapi=true <node>).
# Does NOT apply to backend-pinned.
#EXCLUDE_LABEL=noapi
# Extra service backend-pinned on exactly one node (hostname). Without PINNED_NODE the service does not exist (an empty old one is removed on the next deploy).
# It has no published port by default; the ingress port belongs to backend. Set BACKEND_PINNED_PORT to publish one
# (then the reverse proxy upstream needs both ports).
#PINNED_NODE=node-2
#PINNED_REPLICAS=1
#BACKEND_PINNED_PORT=38081
